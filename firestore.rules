rules_version = '2';

// Security rules for the golfhandicap-14246 Firestore database.
//
// This file is a checked-in copy of what should be deployed in the Firebase
// console (Firestore Database → Rules). Nothing in this repo deploys it — there
// is no Firebase CLI setup here and the app is a single static page — so if the
// rules are ever changed in the console, update this file to match. (Same
// pattern as the sprint-velocity and paptrack-ios repos.)
//
// PASTE THESE INTO THE CONSOLE BEFORE SIGNING IN FOR THE FIRST TIME. Firestore's
// default rules for a new project either deny everything (sync silently fails)
// or, in test mode, allow every signed-in user to read every other user's data.
service cloud.firestore {
  match /databases/{database}/documents {

    // Sync stores one document per signed-in user, holding { state, updatedAt }.
    // The {uid} path segment is the user's Firebase auth UID, so comparing it to
    // request.auth.uid is what confines each account to its own record — a rule of
    // just `request.auth != null` would let any signed-in Google account read every
    // other user's rounds, while refusing anonymous callers identically, so the
    // difference is invisible from outside.
    match /golfhandicap/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is denied by default: there is deliberately no
    // `match /{document=**}` catch-all, and the app touches no other path.
  }
}
